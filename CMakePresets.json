{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-native",
      "displayName": "gcc Native",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/toolchains/native.cmake"
      }
    },
    {
      "name": "devcontainer-arm-none-eabi",
      "displayName": "Devcontainer ARM (bare-metal)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-none-eabi",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/toolchains/arm-toolchain.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-native",
      "configurePreset": "gcc-native"
    },
    {
      "name": "build-arm-none-eabi",
      "configurePreset": "devcontainer-arm-none-eabi"
    }
  ]
}