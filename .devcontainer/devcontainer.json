// Standard dev container for a C++ repo on mdnf1992/cpp-dev. Copy it to the repo's
// .devcontainer/ and adjust.
{
    "name": "C++ Dev. Container",
    "image": "mdnf1992/cpp-dev",
    // GPU / SYCL variants: "mdnf1992/sycl-dev:cuda" or "mdnf1992/sycl-dev:tegra", and in runArgs below
    // "--gpus", "all" (cuda) or "--runtime", "nvidia" (tegra).
    "runArgs": [
        // "--gpus", "all",
        // "--runtime", "nvidia",
        // Hardware access (I2C, serial, cameras, V4L2, ...):
        // "--privileged",
        // "--device=/dev/i2c-1",
    ],
    "mounts": [
        // One volume per build directory, named after the workspace and the dev container, so a
        // build never lands in a synced folder. NEVER mount one volume on two targets: that
        // aliases the build directories and corrupts both.
        "source=${localWorkspaceFolderBasename}-build-${devcontainerId},target=${containerWorkspaceFolder}/build,type=volume"
        // A second build directory needs its own volume, e.g. for build2:
        // "source=${localWorkspaceFolderBasename}-build2-${devcontainerId},target=${containerWorkspaceFolder}/build2,type=volume",
        // udev and /dev for hardware:
        // "source=/run/udev,target=/run/udev,type=bind,readonly",
        // "source=/dev,target=/dev,type=bind",
    ],
    // Ports of the services the repo runs (gRPC, ...):
    // "forwardPorts": [50051],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "DrBlury.protobuf-vsc"
            ],
            "settings": {
                "clangd.arguments": ["-header-insertion=never"],
                "cmake.useCMakePresets": "always",
                "C_Cpp.intelliSenseEngine": "disabled"
            }
        }
    }
}
